+static void ModelBrowser_loadFolder( const ModelFS& folder, const char* path ){
+	ModelGraph_clear();
+	g_ModelBrowser.m_currentFolder = &folder;
+	g_ModelBrowser.m_currentFolderPath = path;
+
+	StringOutputStream filename( 128 );
+	for( const CopiedString& model : folder.m_files ){
+		filename( path, model );
+		auto *modelNode = new ModelNode;
+		modelNode->setModel( filename );
+		NodeSmartReference node( modelNode->node() );
+		Node_getTraversable( g_modelGraph->root() )->insert( node );
+	}
+	g_ModelBrowser.forEachModelInstance( models_set_transforms() );
+	g_ModelBrowser.queueDraw();
+}
 
