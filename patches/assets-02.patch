 typedef ReferenceCaller<ModelPaths_ArchiveVisitor, void(const char*), ModelPaths_addFromArchive> ModelPaths_addFromArchiveCaller;
 
+void ModelBrowser_showProps( const QString& filter, bool fromStart ){
+	// The Engine profile exposes its placeable props as glTF under props/.
+	ModelGraph_clear();
+	auto& files = g_ModelBrowser.m_modelFS.m_files;
+	files.clear();
+	class PropsVisitor final : public Archive::Visitor
+	{
+		std::set<CopiedString>& m_files;
+		const QString& m_filter;
+		bool m_fromStart;
+	public:
+		PropsVisitor( std::set<CopiedString>& files, const QString& filter, bool fromStart )
+			: m_files( files ), m_filter( filter ), m_fromStart( fromStart ){
+		}
+		void visit( const char* name ) override {
+			if( !string_equal_nocase( path_get_extension( name ), "gltf" ) )
+				return;
+			const auto label = QString::fromUtf8( name ).mid( 6 );
+			if( m_fromStart? label.startsWith( m_filter, Qt::CaseInsensitive ) : label.contains( m_filter, Qt::CaseInsensitive ) )
+				m_files.emplace( name );
+		}
+	} visitor( files, filter, fromStart );
+	GlobalFileSystem().forEachArchive( ReferenceCaller<PropsVisitor, void(const char*), +[]( PropsVisitor& visitor, const char* archiveName ){
+		if( auto* archive = GlobalFileSystem().getArchive( archiveName, false ) )
+			archive->forEachFile( Archive::VisitorFunc( visitor, Archive::eFiles, 99 ), "props/" );
+	}>( visitor ), false, false );
+	ModelBrowser_loadFolder( g_ModelBrowser.m_modelFS, "" );
+}
