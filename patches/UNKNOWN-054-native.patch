+void MissingAssets_refresh( const char* mapPath ){
+#ifdef WIN32
+    static QPointer<QDockWidget> dock;
+    static QPointer<QPlainTextEdit> report;
+    static QPointer<QProcess> scan;
+    auto* window = qobject_cast<QMainWindow*>( MainFrame_getWindow() );
+    if ( !window )
+        return;
+    const QString script = QCoreApplication::applicationDirPath() + "/Check_Map_Assets.ps1";
+    if ( !QFileInfo::exists( script ) )
+        return;
+    if ( scan ) {
+        scan->disconnect();
+        scan->kill();
+        scan->deleteLater();
+        scan.clear();
+    }
+    const QFileInfo map( QString::fromUtf8( mapPath ) );
+    if ( !map.isAbsolute() || !map.isFile() ) {
+        if ( report )
+            report->clear();
+        if ( dock )
+            dock->hide();
+        return;
+    }
+    if ( !dock ) {
+        dock = new QDockWidget( "Missing Assets", window );
+        dock->setObjectName( "RawFrontMissingAssets" );
+        auto* contents = new QWidget( dock );
+        auto* layout = new QVBoxLayout( contents );
+        report = new QPlainTextEdit( contents );
+        report->setReadOnly( true );
+        layout->addWidget( report );
+        auto* copy = new QPushButton( "Copy Report", contents );
+        layout->addWidget( copy );
+        QObject::connect( copy, &QPushButton::clicked, report.data(), [] {
+            if ( report )
+                QApplication::clipboard()->setText( report->toPlainText() );
+        } );
+        dock->setWidget( contents );
+        window->addDockWidget( Qt::BottomDockWidgetArea, dock );
+        dock->hide();
+    }
+    auto* process = new QProcess( dock );
+    scan = process;
+    QObject::connect( process, qOverload<int, QProcess::ExitStatus>( &QProcess::finished ),
+                      dock.data(), [process]( int code, QProcess::ExitStatus ) {
+        const QString text = QString::fromLocal8Bit( process->readAllStandardOutput() ).trimmed();
+        report->setPlainText( code == 0 ? text : QString::fromLocal8Bit( process->readAllStandardError() ) );
+        dock->setVisible( code != 0 || !text.startsWith( "Missing Assets: 0" ) || text.count( '\n' ) > 1 );
+        process->deleteLater();
+    } );
+    QObject::connect( process, &QProcess::errorOccurred, dock.data(), [process]( QProcess::ProcessError error ){
+        if ( error == QProcess::FailedToStart ) {
+            report->setPlainText( process->errorString() );
+            dock->show();
+            process->deleteLater();
+        }
+    } );
+    process->start( "powershell.exe", { "-NoProfile", "-NonInteractive", "-File", script,
+                                        "-Map", map.absoluteFilePath() } );
+#else
+    (void)mapPath;
+#endif
+}
+
