+bool Map_PrepareOpen( const char* filename, CopiedString& prepared ){
+	prepared = filename;
+	const auto source = QString::fromLatin1( filename );
+	QFile input( source );
+	if( !input.open( QIODevice::ReadOnly ) )
+		return true;
+	auto header = input.readLine( 128 ).trimmed();
+	input.close();
+	if( header.startsWith( "\xef\xbb\xbf" ) )
+		header.remove( 0, 3 );
+	if( header != "iwmap 4" )
+		return true;
+
+	const auto fail = []( const QString& message ){
+		QMessageBox::warning( MainFrame_getWindow(), "CoD2 Import", message );
+		return false;
+	};
+	const QDir app( QString::fromLatin1( AppPath_get() ) );
+	const auto converter = app.filePath( "import_cod2_map.py" );
+	if( !QFileInfo( converter ).isFile() )
+		return fail( "The CoD2 converter is missing from this installation." );
+	auto python = QStandardPaths::findExecutable( "python" );
+	QStringList arguments;
+	if( python.isEmpty() || QDir::fromNativeSeparators( python ).contains( "/Microsoft/WindowsApps/", Qt::CaseInsensitive ) ){
+		python = QStandardPaths::findExecutable( "py" );
+		arguments << "-3";
+	}
+	if( python.isEmpty() )
+		return fail( "CoD2 import requires Python 3.9 or later." );
+
+	const QDir engine( QString::fromLatin1( EnginePath_get() ) );
+	const auto maps = engine.filePath( "rawfront/maps" );
+	if( !engine.mkpath( "rawfront/maps" ) )
+		return fail( "The RawFront maps directory is not writable." );
+	QTemporaryDir destination( QDir( maps ).filePath( "cod2_import_XXXXXXXX" ) );
+	if( !destination.isValid() )
+		return fail( "Could not create a directory for the converted map." );
+	auto name = QFileInfo( source ).completeBaseName().toLower();
+	name.replace( QRegularExpression( "[^a-z0-9_]" ), "_" );
+	const auto target = QDir( destination.path() ).filePath(
+		name.left( 40 ) + "_" + QFileInfo( destination.path() ).fileName().toLower() + ".map" );
+
+	QProcess process;
+	process.setWorkingDirectory( app.absolutePath() );
+	process.start( python, arguments << converter << source << target );
+	if( !process.waitForStarted() )
+		return fail( process.errorString() );
+	if( !process.waitForFinished( 120000 ) ){
+		process.kill();
+		process.waitForFinished();
+		return fail( "CoD2 conversion timed out." );
+	}
+	const auto report = target.chopped( 4 ) + ".import.json";
+	if( process.exitStatus() != QProcess::NormalExit || process.exitCode() != 0
+	    || !QFileInfo( target ).isFile() || !QFileInfo( report ).isFile() ){
+		const auto error = QString::fromLocal8Bit( process.readAllStandardError() ).trimmed();
+		return fail( error.isEmpty() ? QString( "CoD2 conversion failed (exit %1)." ).arg( process.exitCode() ) : error );
+	}
+
+	destination.setAutoRemove( false );
+	prepared = target.toLatin1().constData();
+	globalOutputStream() << "CoD2 import report: " << report.toLatin1().constData() << '\n';
+	return true;
+}
