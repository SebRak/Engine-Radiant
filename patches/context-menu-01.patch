+namespace
+{
+struct RawFrontEntityMenuItem
+{
+	const char* label;
+	const char* classname;
+};
+
+constexpr RawFrontEntityMenuItem rawFrontActors[][3] = {
+	{ { "Idle", "Actor_soldier_polish_idle" }, { "Crouch", "Actor_soldier_polish_crouch_idle" }, { "Prone", "Actor_soldier_polish_prone_idle" } },
+	{ { "Idle", "Actor_soldier_forest_idle" }, { "Crouch", "Actor_soldier_forest_crouch_idle" }, { "Prone", "Actor_soldier_forest_prone_idle" } }
+};
+
+constexpr RawFrontEntityMenuItem rawFrontDirectEntities[] = { { "Lamp", "lamp" }, { "Prop", "prop" } };
+constexpr RawFrontEntityMenuItem rawFrontOtherEntities[] = { { "Marker", "marker" }, { "Part", "part" }, { "Trigger", "trigger" } };
+
+class RawFrontAdditionalEntityVisitor : public EntityClassVisitor
+{
+	QMenu& m_menu;
+	XYWnd& m_view;
+public:
+	RawFrontAdditionalEntityVisitor( QMenu& menu, XYWnd& view ) : m_menu( menu ), m_view( view ){
+	}
+	void visit( EntityClass* entityClass ) override {
+		const char* name = entityClass->name();
+		if ( string_equal( name, "Spawn" ) )
+			return; // The Spawn submenu creates native RawFront markers.
+		for ( const auto& actors : rawFrontActors )
+			for ( const auto& actor : actors )
+				if ( string_equal( name, actor.classname ) )
+					return;
+		for ( const auto& item : rawFrontDirectEntities )
+			if ( string_equal( name, item.classname ) )
+				return;
+		for ( const auto& item : rawFrontOtherEntities )
+			if ( string_equal( name, item.classname ) )
+				return;
+
+		const QByteArray classname( name );
+		m_menu.addAction( name, &m_menu, [view = &m_view, classname](){
+			view->OnEntityCreate( classname.constData() );
+		} );
+	}
+};
+}
+
+void XYWnd::OnRawFrontContextMenu(){
+	QMenu menu( MainFrame_getWindow() );
+	g_entityCreationOffset = 0;
+	const bool hasSelection = GlobalSelectionSystem().countSelected() != 0;
+
+	auto* select = menu.addMenu( "Select" );
+	select->addAction( "Select All Inside", Select_InsideKeepBounds )->setEnabled( hasSelection );
+
+	const auto addCommand = []( QMenu* submenu, const char* label, const char* command ){
+		return submenu->addAction( label, submenu, [command](){
+			GlobalCommands_find( command ).m_callback();
+		} );
+	};
+	auto* prefab = menu.addMenu( "Prefab" );
+	addCommand( prefab, "Insert Prefab…", "ImportMap" );
+	addCommand( prefab, "Save Selection as Prefab…", "SaveSelected" )->setEnabled( hasSelection );
+
+	auto* geometry = menu.addMenu( "Geometry" );
+	addCommand( geometry, "Make Structural", "MakeStructural" )->setEnabled( hasSelection );
+	addCommand( geometry, "Make Detail", "MakeDetail" )->setEnabled( hasSelection );
+
+	SurfaceInspector_addCollisionMenuItems( *menu.addMenu( "Surface Properties" ) );
+	menu.addSeparator();
+
+	const auto addEntity = [this]( QMenu* submenu, const RawFrontEntityMenuItem& item ){
+		submenu->addAction( item.label, submenu, [this, classname = item.classname](){
+			OnEntityCreate( classname );
+		} );
+	};
+	auto* actor = menu.addMenu( "Actor" );
+	auto* polish = actor->addMenu( "Polish" );
+	auto* forest = actor->addMenu( "Forest" );
+	for ( const auto& item : rawFrontActors[0] )
+		addEntity( polish, item );
+	for ( const auto& item : rawFrontActors[1] )
+		addEntity( forest, item );
+
+	auto* spawn = menu.addMenu( "Spawn" );
+	constexpr RawFrontEntityMenuItem markers[] = { { "General", "spawn" }, { "Side A", "sd_a" }, { "Side B", "sd_b" }, { "Zombie", "zombie_spawn" } };
+	for ( const auto& marker : markers )
+		spawn->addAction( marker.label, spawn, [this, name = marker.classname](){
+			OnEntityCreate( "marker", name );
+		} );
+
+	for ( const auto& item : rawFrontDirectEntities )
+		addEntity( &menu, item );
+	auto* entities = menu.addMenu( "Entities" );
+	for ( const auto& item : rawFrontOtherEntities )
+		addEntity( entities, item );
+	RawFrontAdditionalEntityVisitor additionalEntities( *entities, *this );
+	GlobalEntityClassManager().forEach( additionalEntities );
+
+	menu.exec( QCursor::pos() );
+}
