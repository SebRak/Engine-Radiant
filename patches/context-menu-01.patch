+void SurfaceInspector_addCollisionMenuItems( QMenu& menu ){
+	const auto selection = rawFrontCollisionSelection();
+	const bool selected = selection.material != nullptr;
+	for ( int i = 0; i < 3; ++i ) {
+		const int bit = 1 << i;
+		const bool mixed = selected && ( ( selection.commonFlags ^ selection.anyFlags ) & bit );
+		QString label = QString::fromUtf8( rawFrontCollisionLabels[i] );
+		if ( mixed )
+			label += QStringLiteral( " (mixed)" );
+		auto* action = menu.addAction( label );
+		action->setCheckable( true );
+		action->setChecked( selected && ( selection.commonFlags & bit ) );
+		action->setEnabled( selected );
+		QObject::connect( action, &QAction::triggered, &menu, [bit]( bool checked ){
+			getSurfaceInspector().applyCollisionFlag( bit, checked );
+		} );
+	}
+}
