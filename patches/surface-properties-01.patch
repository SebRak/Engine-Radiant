+void SurfaceInspector::updateCollisionProperties(){
+	if ( m_surfaceMaterial == nullptr )
+		return;
+
+	const char* material = nullptr;
+	bool mixedMaterial = false;
+	int commonFlags = 7;
+	int anyFlags = 0;
+	Scene_ForEachSelectedBrushFace( GlobalSceneGraph(), [&]( Face& face ){
+		if ( material == nullptr )
+			material = face.GetShader();
+		else if ( !string_equal( material, face.GetShader() ) )
+			mixedMaterial = true;
+
+		ContentsFlagsValue flags;
+		face.GetFlags( flags );
+		commonFlags &= flags.m_contentFlags;
+		anyFlags |= flags.m_contentFlags;
+	} );
+	const bool selected = material != nullptr;
+	m_surfaceMaterial->setText( !selected ? QStringLiteral( "Select brush faces" )
+	                            : mixedMaterial ? QStringLiteral( "Mixed materials" )
+	                            : QString::fromUtf8( material ) );
+	for ( int i = 0; i < 3; ++i ) {
+		const int bit = 1 << i;
+		const bool mixed = selected && ( ( commonFlags ^ anyFlags ) & bit );
+		auto* check = m_collisionFlags[i];
+		check->setEnabled( selected );
+		check->setTristate( mixed );
+		check->setCheckState( mixed ? Qt::PartiallyChecked
+		                     : selected && ( commonFlags & bit ) ? Qt::Checked
+		                     : Qt::Unchecked );
+	}
+}
+
+void SurfaceInspector::applyCollisionFlag( int bit, bool enabled ){
+	if ( g_SelectedFaceInstances.empty() )
+		return;
+
+	{
+		UndoableCommand undo( "rawFrontSurfaceCollisionFlag" );
+		Scene_ForEachSelectedBrushFace( GlobalSceneGraph(), [&]( Face& face ){
+			ContentsFlagsValue flags;
+			face.GetFlags( flags );
+			const int contents = enabled ? flags.m_contentFlags | bit : flags.m_contentFlags & ~bit;
+			if ( contents != flags.m_contentFlags ) {
+				flags.m_contentFlags = contents;
+				face.SetFlags( flags );
+			}
+		} );
+	}
+	SceneChangeNotify();
+	updateCollisionProperties();
 }
 
