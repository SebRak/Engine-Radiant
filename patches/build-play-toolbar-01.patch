+		m_lighting->addItem( "Evening", "skies/evening" );
+		auto* quality = new QComboBox( this );
+		quality->addItem( "Engine Default" );
+		quality->setEnabled( false );
+		auto addField = [&]( const char* label, QComboBox* field ){
+			auto* text = new QLabel( label, this );
+			text->setMargin( 4 );
+			field->setAccessibleName( label );
+			addWidget( text );
+			addWidget( field );
+			addSeparator();
+		};
+		addField( "Game Mode", m_mode );
+		addField( "Lighting Preset", m_lighting );
+		addField( "Lighting Quality", quality );
+
+		auto* dock = new QDockWidget( "Build Validation", window );
+		dock->setObjectName( "BuildValidation_Dock" );
+		auto* contents = new QWidget( dock );
+		auto* layout = new QVBoxLayout( contents );
+		m_report = new QPlainTextEdit( contents );
+		m_report->setReadOnly( true );
+		layout->addWidget( m_report );
+		auto* check = new QPushButton( "Validate Map", contents );
+		layout->addWidget( check );
+		dock->setWidget( contents );
+		window->addDockWidget( Qt::BottomDockWidgetArea, dock );
+
+		auto* compile = addAction( "Compile" );
+		QObject::connect( compile, &QAction::triggered, this, [this, dock](){
+			validate();
+			dock->show();
+			m_report->appendPlainText( "Compiler backend unavailable" );
+		} );
+		auto* play = addAction( QString::fromUtf8( "\xE2\x96\xB6 Play" ) );
+		play->setToolTip( "Play using the existing TDM pipeline and the map's lighting settings." );
+		QObject::connect( play, &QAction::triggered, this, &Build_runEnginePlay );
+		QObject::connect( check, &QPushButton::clicked, this, [this](){ validate(); } );
+		QObject::connect( m_mode, qOverload<int>( &QComboBox::currentIndexChanged ), this, [this](){ persistSelection(); } );
+		QObject::connect( m_lighting, qOverload<int>( &QComboBox::currentIndexChanged ), this, [this](){ persistSelection(); } );
+	}
+
+	void refresh( const char* filename ){
+		m_hasMap = true;
+		const QFileInfo file( QString::fromUtf8( filename ) );
+		const QString path = file.isAbsolute() ? QDir::cleanPath( file.absoluteFilePath() ) : QString();
+		if ( path != m_mapPath ) {
+			m_mapPath = path;
+			const QSignalBlocker modeSignals( m_mode );
+			const QSignalBlocker lightingSignals( m_lighting );
+			QSettings settings( "RawFront", "Radiant Build and Play" );
+			m_mode->setCurrentIndex( m_mapPath.isEmpty() ? 0 : qMax( 0, m_mode->findData( settings.value( settingsKey() + "mode" ) ) ) );
+			m_lighting->setCurrentIndex( m_mapPath.isEmpty() ? 0 : qMax( 0, m_lighting->findData( settings.value( settingsKey() + "lighting" ) ) ) );
+		}
+		else if ( path.isEmpty() ) {
+			const QSignalBlocker modeSignals( m_mode );
+			const QSignalBlocker lightingSignals( m_lighting );
+			m_mode->setCurrentIndex( 0 );
+			m_lighting->setCurrentIndex( 0 );
+		}
+		validate();
+	}
+};
