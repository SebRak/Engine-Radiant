+class BuildMarkerWalker final : public scene::Graph::Walker
+{
+	QStringList& m_names;
+public:
+	explicit BuildMarkerWalker( QStringList& names ) : m_names( names ) {}
+	bool pre( const scene::Path& path, scene::Instance& ) const override {
+		if ( path.size() == 2 ) {
+			if ( const Entity* entity = Node_getEntity( path.top() ) ) {
+				if ( string_equal( entity->getClassName(), "marker" ) ) {
+					m_names.append( QString::fromUtf8( entity->getKeyValue( "name" ) ) );
+				}
+				else if ( string_equal_nocase( entity->getClassName(), "Spawn" )
+				          && string_empty( entity->getKeyValue( "name" ) ) ) {
+					m_names.append( "spawn" ); // the existing Play export converts this helper
+				}
+			}
+		}
+		return path.size() < 2;
+	}
+};
+
+QString buildMapMetadata( const QFileInfo& map ){
+	const QString name = map.completeBaseName();
+	const QString adjacent = map.dir().filePath( name + ".jsonc" );
+	if ( QFileInfo::exists( adjacent ) ) {
+		return adjacent;
+	}
+	const QDir workspace( QCoreApplication::applicationDirPath() + "/rawfront-workspace" );
+	const QString relative = workspace.relativeFilePath( map.absoluteFilePath() );
+	if ( relative.startsWith( "editor/rawfront/maps/" )
+	     || relative == QString( "content/maps/%1/%1.map" ).arg( name ) ) {
+		return workspace.filePath( QString( "stock/maps/%1/%1.jsonc" ).arg( name ) );
+	}
+	return adjacent;
+}
+
+QJsonDocument readBuildMapMetadata( QFile& file ){
+	QString json = QString::fromUtf8( file.readAll() );
+	// Keep quoted tokens intact while removing JSONC comments and trailing commas.
+	static const QRegularExpression comments( R"json(("(?:\\.|[^"\\])*")|//[^\r\n]*|/\*[\s\S]*?\*/)json" );
+	static const QRegularExpression trailingCommas( R"json(("(?:\\.|[^"\\])*")|,(?=\s*[\]}]))json" );
+	json.replace( comments, QStringLiteral( "\\1 " ) );
+	json.replace( trailingCommas, QStringLiteral( "\\1" ) );
+	return QJsonDocument::fromJson( json.toUtf8() );
+}
+
+class BuildPlayToolbar final : public QToolBar
+{
+	QComboBox* m_mode = new QComboBox( this );
+	QComboBox* m_lighting = new QComboBox( this );
+	QPlainTextEdit* m_report;
+	QString m_mapPath;
+	bool m_hasMap = false;
+
+	QString settingsKey() const {
+		QString path = m_mapPath;
+#ifdef WIN32
+		path = path.toCaseFolded();
+#endif
+		return "maps/" + QString::fromLatin1( path.toUtf8().toHex() ) + '/';
+	}
+
+	void persistSelection(){
+		if ( !m_mapPath.isEmpty() ) {
+			QSettings settings( "RawFront", "Radiant Build and Play" );
+			settings.setValue( settingsKey() + "mode", m_mode->currentData() );
+			settings.setValue( settingsKey() + "lighting", m_lighting->currentData() );
+		}
+		validate();
+	}
+
+	void validate(){
+		QStringList report;
+		const QString mode = m_mode->currentData().toString();
+		const QString preset = m_lighting->currentData().toString();
+		QJsonObject metadata;
+		if ( m_hasMap ) {
+			QStringList markers;
+			GlobalSceneGraph().traverse( BuildMarkerWalker( markers ) );
+			auto requireMarker = [&]( const QString& name, bool prefix ){
+				for ( const QString& marker : markers ) {
+					if ( prefix ? marker.startsWith( name ) : marker == name ) {
+						return;
+					}
+				}
+				report.append( "Missing marker: " + name + ( prefix ? "*" : "" ) );
+			};
+			if ( mode == "tdm" ) {
+				requireMarker( "spawn", true );
+			}
+			else {
+				requireMarker( "sd_a", true );
+				requireMarker( "sd_b", true );
+				if ( mode == "sd" ) {
+					requireMarker( "bomb_a", false );
+					requireMarker( "bomb_b", false );
+				}
+				else {
+					requireMarker( "ctf_a", false );
+					requireMarker( "ctf_b", false );
+				}
+			}
+		}
+		if ( m_mapPath.isEmpty() ) {
+			report.append( "Save the map to check its JSONC metadata." );
+		}
+		else {
+			QFile file( buildMapMetadata( QFileInfo( m_mapPath ) ) );
+			bool declared = false;
+			if ( file.open( QIODevice::ReadOnly ) ) {
+				const auto document = readBuildMapMetadata( file );
+				if ( document.isObject() ) {
+					metadata = document.object();
+					declared = metadata.value( "gametypes" ).toArray().contains( QJsonValue( mode ) );
+				}
+				else {
+					report.append( "Invalid map JSONC: " + file.fileName() );
+				}
+			}
+			else {
+				report.append( "Map JSONC unavailable: " + file.fileName() );
+			}
+			if ( !declared ) {
+				report.append( "Missing game mode declaration: " + mode );
+			}
+		}
+		if ( report.isEmpty() ) {
+			report.append( "Build validation passed." );
+		}
+		const QString sky = preset.isEmpty()
+		                    ? metadata.value( "sky" ).toObject().value( "image" ).toString()
+		                    : preset;
+		report.append( "Lighting preset (sky.image): " + ( sky.isEmpty() ? QString( "Map Settings" ) : sky ) );
+		report.append( "Play uses the current TDM pipeline and the map's lighting settings." );
+		m_report->setPlainText( report.join( '\n' ) );
+	}
+
+public:
+	explicit BuildPlayToolbar( QMainWindow* window ) : QToolBar( "Build & Play", window ){
+		setObjectName( "BuildPlay_Toolbar" );
+		setAllowedAreas( Qt::TopToolBarArea | Qt::BottomToolBarArea );
+		m_mode->addItem( "Team Deathmatch", "tdm" );
+		m_mode->addItem( "Search & Destroy", "sd" );
+		m_mode->addItem( "Capture the Flag", "ctf" );
+		m_lighting->addItem( "Map Settings", QString() );
